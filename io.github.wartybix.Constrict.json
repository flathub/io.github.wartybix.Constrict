{
    "id" : "io.github.wartybix.Constrict",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command" : "constrict",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--require-version=1.14.5"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin"
    },
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
      "cleanup-commands": [
        "python3 -m compileall --invalidation-mode=unchecked-hash /app"
    ],  
    "modules" : [
        {
            "name" : "libva-utils",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://github.com/intel/libva-utils/archive/refs/tags/2.24.0.tar.gz",
                    "sha256" : "bf959a1ced3cde8176a7ff50ad358ee98e93301ac068581a8b2617c5b83afcb3"
                }
            ]
        },
        {
            "name" : "gst-thumbnailers",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://download.gnome.org/sources/gst-thumbnailers/1.1/gst-thumbnailers-1.1.0.tar.xz",
                    "sha256" : "d980be383088261f8bc2ec5a8953edaca7c59abcc90abf24a5052493e726bf53"
                },
                "generated-sources-gst-thumbnailers.json",
                {
                    "type": "shell",
                    "commands" : [
                        "mkdir .cargo",
                        "cp cargo/config .cargo/"
                    ]
                }
            ]
        },
        {
            "name" : "constrict",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://github.com/Wartybix/Constrict/archive/refs/tags/26.10.tar.gz",
                    "mirror-urls": [
                        "https://gitlab.gnome.org/World/Constrict/-/archive/26.10/Constrict-26.10.tar.gz"
                    ],
                    "sha256" : "082a8a3db65b7cfb86cee32f65160f9da31964fe9e5d142f78fb0765da1cf1d5"
                }
            ]
        }
    ]
}
